# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/

# --- Test / tooling caches ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
.tmp_pytest_verify*/

# --- Model / dataset caches (re-downloadable, not source) ---
hf_cache/
*.safetensors
*.bin
*.pt
*.ckpt

# Benchmark data downloaded from the Hugging Face Hub. Re-downloadable and
# governed by its own licence, so it is not vendored. See data/README.md for
# the exact commands and the expected row counts.
data/tofu/
data/uds_annotations/

# --- Archives (redundant snapshots of this same tree) ---
*.tar.gz
*.zip

# --- Duplicate copies of deeperase/ pulled back from the GPU box ---
server/extracted/
server/from_gpu/

# --- OS / editor ---
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
*.swp
.vscode/
.idea/

# --- Local run logs ---
deeperase/run_log*.txt
deeperase/breadth_log*.txt
deeperase/study_ga*.txt

# --- Third-party literature PDFs (copyrighted; see literature/README.md) ---
# The PDFs themselves are never committed. The index that says which papers
# belong there, and how to fetch them, is.
literature/*
!literature/README.md
!literature/download_manifest.json

*.pdf
# ...except our own reports, which are project deliverables, not third-party material.
!report/*.pdf

# Office lock files
~$*
